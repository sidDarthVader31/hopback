{
  "manifest_version": 3,
  "name": "HopBack: Jump to Your Questions in AI Chats",
  "short_name": "HopBack",
  "version": "0.1.0",
  "description": "Hop back to any question you asked in ChatGPT, Claude, Gemini, Perplexity, DeepSeek, Grok and Copilot. No data leaves your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
