{
  "name": "hopback",
  "version": "1.0.0",
  "description": "Hop back to any question you asked in ChatGPT, Claude, Gemini and other AI chats.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "media": "npm run build && playwright test -c playwright.media.config.ts capture",
    "check": "npm run typecheck && npm run lint && npm test && npm run e2e",
    "zip": "npm run build && node scripts/zip.mjs",
    "store-assets": "npm run build && playwright test -c playwright.media.config.ts store"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "gifenc": "^1.0.3",
    "happy-dom": "^21.0.4",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
